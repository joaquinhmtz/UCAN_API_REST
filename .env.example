#########################################
# Entorno de ejecución
#########################################
NODE_ENV=development      
PORT=3000                 
HOST=127.0.0.1            

#########################################
# Base de datos
#########################################
MONGODB_URI=mongodb://localhost:27017/miapp

#########################################
# Autenticación (JWT)
#########################################
JWT_SECRET=change_this_secret_key          
JWT_EXPIRES_IN=1h                          

#########################################
# Email SMTP (opcional)
#########################################
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MiApp Soporte <soporte@miapp.com>"
